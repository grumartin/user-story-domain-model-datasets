sequenceDiagram
    %% SD2 - Discover events on the homepage
    %% Stories: 4, 46, 47, 48
    %% Description: A visitor sees popular upcoming events and a calendar view and opens an event page. A registered user gets events recommended from their profile.
    actor VI as Visitor
    actor UP as User (person)
    participant EV as Event
    participant U as User
    participant GE as Genre
    participant ET as EventType

    %% covers 47
    VI->>EV: see popular upcoming events
    %% covers 46
    VI->>EV: see events in a calendar view
    %% covers 4
    UP->>U: see recommended events
    U->>GE: preferred genres
    U->>ET: preferred event types
    GE->>EV: matching events
    ET->>EV: matching events
    %% covers 48
    VI->>EV: open event page
