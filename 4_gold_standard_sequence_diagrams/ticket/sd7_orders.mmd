sequenceDiagram
    %% SD7 - View orders and upcoming events
    %% Stories: 8, 9
    %% Description: A user views previous ticket orders and the upcoming events for which tickets were bought.
    actor UP as User (person)
    participant U as User
    participant ORD as Order
    participant TI as Ticket
    participant EV as Event

    %% covers 8, 9
    UP->>U: view order history and upcoming events
    U->>ORD: orders
    ORD->>TI: tickets
    TI->>EV: events of bought tickets
