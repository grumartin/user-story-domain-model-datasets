sequenceDiagram
    %% SD5 - Buy tickets
    %% Stories: 12, 14, 15, 16, 17, 20, 21, 22, 23, 24, 25, 26
    %% Description: A visitor chooses ticket types and seats on the event page, puts tickets in the cart, checks out as a user or as a guest, and pays.
    actor VI as Visitor
    participant EV as Event
    participant TI as Ticket
    participant VE as Venue
    participant ORD as Order
    participant U as User
    participant PA as Payment

    %% covers 12
    VI->>EV: buy tickets on the event page
    %% covers 21, 23
    EV->>TI: ticket types and available seats
    %% covers 22
    EV->>VE: seat map
    %% covers 20, 24
    VI->>ORD: add tickets to the cart
    ORD->>TI: reserved tickets
    alt logged in
        ORD->>U: saved details
    else guest
        %% covers 14, 15, 16, 17
        VI->>ORD: enter name and email only
    end
    %% covers 25
    VI->>ORD: review order summary
    %% covers 26
    ORD->>PA: payment methods
    %% covers 26
    VI->>PA: pay
